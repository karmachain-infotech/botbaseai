# ============================================
# BotbaseAI — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# --- Supabase ---
# Create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM Provider ---
# AI_PROVIDER: "groq" (default), "ollama", or "gemini"
# Set to "ollama" to use local Ollama
AI_PROVIDER=groq

# --- Groq (default provider) ---
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# --- Gemini ---
# Used for embeddings (text-embedding-001, 384 dims)
# Also used when AI_PROVIDER=gemini for chat completions
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Ollama ---
# Used when AI_PROVIDER=ollama
# Install Ollama from https://ollama.com and pull a model like:
#   ollama pull llama3
# Then start the server: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Anthropic (optional) ---
# Get your API key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Stripe ---
# Create products & prices at https://dashboard.stripe.com/products
STRIPE_SECRET_KEY=sk_live_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key

# Stripe Price IDs (replace with actual IDs from your Stripe dashboard)
# Create products & prices at https://dashboard.stripe.com/products
# Example: price_1QzXx...
# If left as literal numbers (e.g. "30"), prices will be created automatically on checkout.
NEXT_PUBLIC_STRIPE_PRICE_HOBBY_MONTHLY=price_1QzXxHobbyMonthly
NEXT_PUBLIC_STRIPE_PRICE_HOBBY_YEARLY=price_1QzXxHobbyYearly
NEXT_PUBLIC_STRIPE_PRICE_STANDARD_MONTHLY=price_1QzXxStandardMonthly
NEXT_PUBLIC_STRIPE_PRICE_STANDARD_YEARLY=price_1QzXxStandardYearly
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_1QzXxProMonthly
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_1QzXxProYearly

# --- Resend (transactional emails) ---
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-key

# Plan display prices (shown on pricing page, also used as fallback for dynamic price creation)
# VITE_* are available on the client; NEXT_PUBLIC_* are used on the server (stripe.ts)
VITE_PLAN_PRICE_HOBBY_MONTHLY=32
VITE_PLAN_PRICE_HOBBY_YEARLY=384
VITE_PLAN_PRICE_STANDARD_MONTHLY=120
VITE_PLAN_PRICE_STANDARD_YEARLY=1440
VITE_PLAN_PRICE_PRO_MONTHLY=400
VITE_PLAN_PRICE_PRO_YEARLY=4800
NEXT_PUBLIC_PLAN_PRICE_HOBBY_MONTHLY=32
NEXT_PUBLIC_PLAN_PRICE_HOBBY_YEARLY=384
NEXT_PUBLIC_PLAN_PRICE_STANDARD_MONTHLY=120
NEXT_PUBLIC_PLAN_PRICE_STANDARD_YEARLY=1440
NEXT_PUBLIC_PLAN_PRICE_PRO_MONTHLY=400
NEXT_PUBLIC_PLAN_PRICE_PRO_YEARLY=4800

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
